generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  TECHNICIAN
}

enum WorkOrderStatus {
  DRAFT
  QUOTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  TNG
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrdersCreated  WorkOrder[] @relation("CreatedBy")
  workOrdersAssigned WorkOrder[] @relation("AssignedTo")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  tin       String?  // for e-Invoice
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles   Vehicle[]
  workOrders WorkOrder[]
}

model Vehicle {
  id          String   @id @default(cuid())
  plateNumber String   @unique
  make        String
  model       String
  year        Int?
  color       String?
  vin         String?
  mileage     Int?
  notes       String?
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrders WorkOrder[]
}

model WorkOrder {
  id            String          @id @default(cuid())
  orderNumber   String          @unique // internal job number e.g. WO20261110001

  // Document numbers
  quotationNumber String?       // QT20261110001
  invoiceNumber   String?       // INV20261110001
  receiptNumber   String?       // RC20261110001

  status        WorkOrderStatus @default(DRAFT)
  description   String?         // customer complaint
  diagnosis     String?
  laborNotes    String?
  mileageIn     Int?
  mileageOut    Int?

  totalAmount   Float           @default(0)
  partsAmount   Float           @default(0)
  laborAmount   Float           @default(0)
  discount      Float           @default(0)
  taxRate       Float           @default(0)     // SST % applied (snapshot)
  taxScope      String          @default("ALL") // "ALL" or "LABOR" (snapshot)
  taxAmount     Float           @default(0)     // SST charged; totalAmount includes it
  creditedAmount Float          @default(0)     // total of credit notes issued against this invoice
  consolidatedId String?                        // ConsolidatedInvoice that reported this invoice to LHDN
  paidAmount    Float           @default(0)

  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  quotedAt      DateTime?
  confirmedAt   DateTime?
  completedAt   DateTime?
  invoicedAt    DateTime?
  paidAt        DateTime?

  // e-Invoice fields (for later)
  eInvoiceUuid  String?
  eInvoiceLongId String?
  eInvoiceStatus String?        // pending / valid / invalid / cancelled
  submissionUid  String?        // LHDN submission batch id (needed to poll status after refresh)

  // v0.2.9 — buyer scans the QR on the invoice / receipt and fills in their own e-Invoice details
  eInvoiceToken     String?   @unique // random code in the QR link (not guessable)
  buyerRequestedAt  DateTime?         // when the buyer sent their details
  buyerName         String?
  buyerTin          String?
  buyerIdType       String?           // NRIC / PASSPORT / BRN / ARMY
  buyerIdNo         String?
  buyerEmail        String?
  buyerPhone        String?
  buyerAddress      String?
  buyerPostcode     String?
  buyerCity         String?
  buyerStateCode    String?           // LHDN state code 01-17

  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  vehicleId     String
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id])
  createdById   String
  createdBy     User            @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId  String?
  assignedTo    User?           @relation("AssignedTo", fields: [assignedToId], references: [id])

  items         WorkOrderItem[]
  payments      Payment[]
  stockMovements StockMovement[]
  creditNotes    CreditNote[]
}

model WorkOrderItem {
  id              String         @id @default(cuid())
  type            String         // "PART" or "LABOR"
  description     String
  quantity        Float          @default(1)
  unitPrice       Float
  costPrice       Float          @default(0)
  total           Float
  workOrderId     String
  workOrder       WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  amount      Float         // amount applied to the bill (negative = refund). For cash: handed over minus change.
  method      PaymentMethod @default(CASH)
  reference   String?       // TNG / Transfer reference number
  notes       String?
  paidAt      DateTime      @default(now())
  tendered    Float?        // CASH only: money the customer handed over
  changeGiven Float?        // CASH only: change given back (tendered - amount)
  workOrderId String
  workOrder   WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  shiftId     String?       // the counter session (CashShift) this money went through
  shift       CashShift?    @relation(fields: [shiftId], references: [id])
}

// ===== Cash counter: open with a float, close with a cash count =====
// Expected cash in the drawer at close = openingFloat + CASH payments (net of change) - CASH refunds.
model CashShift {
  id           String    @id @default(cuid())
  openedAt     DateTime  @default(now())
  openedByName String
  openingFloat Float
  closedAt     DateTime?
  closedByName String?
  expectedCash Float?    // snapshot taken at close
  countedCash  Float?    // what was physically counted
  variance     Float?    // counted - expected: negative = shortage, positive = overage
  notes        String?

  // v0.2.4 — denomination counts, float kept for tomorrow, and the bank deposit
  openingCount    String?   // JSON {"100":2,"50":0,...}: notes / coins counted when opening
  countedBreakdown String?  // JSON: notes / coins counted when closing
  floatKept       Float?    // cash left in the drawer as tomorrow's float
  depositAmount   Float?    // counted cash - floatKept = cash to bank in (before costs are deducted)
  depositedAt     DateTime? // set when the boss confirms the cash was banked in
  depositedByName String?
  depositRef      String?   // bank slip / reference no.
  reconciled      String?   // JSON {"CARD":{"by":"Ah Boss","at":"2026-11-12T..."}}: non-cash methods the boss has checked

  payments     Payment[]
  vouchers     PaymentVoucher[] // cash paid out of this drawer
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String?
  notes       String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
}

// Shop profile for documents & e-Invoice
model ShopProfile {
  id            String   @id @default(cuid())
  name          String   // shop name
  nameMs        String?  // Malay name if any
  address       String?  // street address line
  city          String?
  postcode      String?
  stateCode     String?  // LHDN state code 01-17
  phone         String?
  email         String?
  tin           String?  // Tax Identification Number
  brn           String?  // Business Registration Number
  sstNumber     String?  // SST registration, or "NA"
  sstRate       Float    @default(0)      // service tax %, e.g. 8. Charged only when sstNumber is set
  sstScope      String   @default("ALL")  // "ALL" = parts + labour taxed, "LABOR" = labour only
  msicCode      String?  // industry code
  msicDesc      String?  // business activity description
  myInvoisClientId     String?
  myInvoisClientSecret String?
  myInvoisSandbox      Boolean  @default(true)
  bankName      String?
  bankAccount   String?
  paymentQrUrl  String?  // URL or path for payment QR image
  logoUrl       String?
  receiptFooter String?  // thank you message
  documentSettings String? // owner-editable quotation, invoice and receipt print layout settings (JSON)
  updatedAt     DateTime @updatedAt
}

// ===== Inventory =====
model InventoryItem {
  id             String   @id @default(cuid())
  name           String
  sku            String?  @unique
  category       String?
  unit           String   @default("pcs")
  quantityOnHand Float    @default(0)
  costPrice      Float    @default(0)
  sellingPrice   Float    @default(0)
  minStockLevel  Float    @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements      StockMovement[]
  workOrderItems WorkOrderItem[]
  supplierItems  SupplierInvoiceItem[]
}

model StockMovement {
  id              String        @id @default(cuid())
  type            String        // IN, OUT, ADJUST
  quantity        Float         // positive for IN, negative for OUT/ADJUST reduction
  notes           String?
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  workOrderId     String?
  workOrder       WorkOrder?    @relation(fields: [workOrderId], references: [id])
  createdAt       DateTime      @default(now())
}

// ===== Credit notes (refunds / reductions after an invoice is issued) =====
model CreditNote {
  id             String    @id @default(cuid())
  number         String    @unique // CN20261111001
  amount         Float     // amount credited, incl. SST
  taxAmount      Float     @default(0) // SST part of amount
  reason         String
  refundAmount   Float     @default(0) // money actually paid back to customer
  refundMethod   String?
  createdAt      DateTime  @default(now())
  createdById    String?
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id])
  eInvoiceUuid   String?
  eInvoiceLongId String?
  eInvoiceStatus String?   // pending / valid / invalid / cancelled / consolidated
  submissionUid  String?
}

// ===== Monthly consolidated e-Invoice for buyers who did not ask for one =====
model ConsolidatedInvoice {
  id             String   @id @default(cuid())
  number         String   @unique // CON-202610
  month          String   @unique // "2026-10"
  orderCount     Int
  netAmount      Float
  taxAmount      Float
  totalAmount    Float
  createdAt      DateTime @default(now())
  eInvoiceUuid   String?
  eInvoiceLongId String?
  eInvoiceStatus String?
  submissionUid  String?
}

// ===== Purchasing: supplier invoices (stock in) and payment vouchers =====
model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  invoices  SupplierInvoice[]
}

model SupplierInvoice {
  id          String   @id @default(cuid())
  internalNo  String   @unique          // SI20261111001
  invoiceNo   String                    // number printed on the supplier's invoice
  invoiceDate DateTime
  dueDate     DateTime?
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  subtotal    Float
  taxAmount   Float    @default(0)
  totalAmount Float
  paidAmount  Float    @default(0)
  status      String   @default("UNPAID") // UNPAID / PARTIAL / PAID
  notes       String?
  imageUrl    String?                   // scanned copy (optional)
  voidedAt    DateTime?                 // set when cancelled; stock was reversed
  voidReason  String?
  createdAt   DateTime @default(now())
  createdById String?

  items       SupplierInvoiceItem[]
  vouchers    PaymentVoucher[]

  @@unique([supplierId, invoiceNo])     // the same invoice cannot be stocked in twice
}

model SupplierInvoiceItem {
  id              String         @id @default(cuid())
  description     String
  sku             String?
  category        String?
  quantity        Float
  unitCost        Float
  total           Float
  invoiceId       String
  invoice         SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem?  @relation(fields: [inventoryItemId], references: [id])
}

model PaymentVoucher {
  id                String   @id @default(cuid())
  number            String   @unique    // PV20261111001
  payee             String
  purpose           String?
  amount            Float
  method            String   @default("CASH")
  reference         String?
  notes             String?
  paidAt            DateTime @default(now())
  createdAt         DateTime @default(now())
  createdById       String?
  supplierInvoiceId String?
  voidedAt          DateTime?            // set when cancelled; amount no longer counts
  voidReason        String?
  shiftId           String?              // set when the cash came out of the counter drawer
  shift             CashShift?       @relation(fields: [shiftId], references: [id])
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])
}


// Immutable operational audit trail. Sensitive credentials and full payment data must never be stored here.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String
  actorRole   String
  action      String
  entityType  String
  entityId    String?
  summary     String
  details     String?  // JSON with non-sensitive before/after values only
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}


// Persistent per-account login throttling survives app restarts. The key is a SHA-256 digest, not an email.
model LoginThrottle {
  key              String   @id
  failures         Int      @default(0)
  windowStartedAt  DateTime @default(now())
  lockedUntil      DateTime?
  updatedAt        DateTime @updatedAt

  @@index([lockedUntil])
}
